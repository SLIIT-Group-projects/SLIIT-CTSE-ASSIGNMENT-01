NODE_ENV=development
PORT=4001

# Use separate DB per service
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/hm_auth

# Shared across all backend services
JWT_SECRET=replace_with_secure_shared_secret
JWT_EXPIRES_IN=7d
INTERNAL_SERVICE_TOKEN=replace_with_secure_internal_token

# Optional (for Swagger links)
PUBLIC_API_BASE_URL=http://localhost:4001
