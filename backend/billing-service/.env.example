NODE_ENV=development
PORT=4005

# Use separate DB per service
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/hm_billing

# Shared across all backend services
JWT_SECRET=replace_with_secure_shared_secret
JWT_EXPIRES_IN=7d
INTERNAL_SERVICE_TOKEN=replace_with_secure_internal_token

# Inter-service URLs
APPOINTMENT_SERVICE_BASE_URL=http://appointment-service:4002
LAB_SERVICE_BASE_URL=http://lab-service:4004

# Used to generate absolute slip URLs
PUBLIC_SERVICE_BASE_URL=http://localhost:4005
PUBLIC_API_BASE_URL=http://localhost:4005
